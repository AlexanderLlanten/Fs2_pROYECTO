# api conecta catálogo, cuentas, sesión y gestión de productos con PostgreSQL.
# local conserva EP2 como referencia; api utiliza los datos persistidos del servidor.
VITE_DATA_SOURCE=local
VITE_API_URL=http://localhost:8080/api/v1
# Docker compila automáticamente en modo api y usa /api/v1 del mismo sitio.
# No se copia este archivo a la imagen ni se requiere editarlo para Docker.
# La opción anterior VITE_CATALOG_SOURCE=api también activa el modo conectado completo.
# Reiniciar Vite después de cambiar las variables. Usar localhost en ambos servicios.
